+    // Onyx : intégration dans la vue passée par --wid, à la place de la
+    // fenêtre que mpv crée d'ordinaire. mpv 0.41 ne lit pas --wid sur macOS.
+    @objc var isEmbedded: Bool { return option.vo.WinID >= 0 }
+    let embedSizeLock = NSLock()
+    var embedPixelSize: CGSize = .zero
+
+    func embedView() {
+        guard let view = self.view,
+              let raw = UnsafeRawPointer(bitPattern: Int(option.vo.WinID)) else {
+            log.error("Invalid --wid, cannot embed the video view")
+            return
+        }
+        let parent = Unmanaged<NSView>.fromOpaque(raw).takeUnretainedValue()
+        view.frame = parent.bounds
+        parent.addSubview(view)
+        updateEmbedSize()
+    }
+
+    func updateEmbedSize() {
+        guard let view = self.view else { return }
+        let scale = view.window?.backingScaleFactor ?? NSScreen.main?.backingScaleFactor ?? 1
+        view.layer?.contentsScale = scale
+        let size = CGSize(width: view.bounds.width * scale, height: view.bounds.height * scale)
+        embedSizeLock.withLock { embedPixelSize = size }
+    }
+
+    func embeddedViewDidResize() {
+        updateEmbedSize()
+        windowDidResize()
+    }
+
+    @objc func drawablePixelSize() -> CGSize {
+        if isEmbedded {
+            return embedSizeLock.withLock { embedPixelSize }
+        }
+        return window?.framePixel.size ?? .zero
+    }
