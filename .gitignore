# Release artifacts
/dist/
app/Output/

# Flutter Web bundle, copied in by publish-image.sh and embedded into the Go
# binary. Only the placeholder is tracked, so `go build` works on a clean
# checkout without Flutter installed.
server/webui/dist/*
!server/webui/dist/.gitkeep


# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
# Sortie d'Xcode, régénérée par `flutter build macos`. Le motif `build/`
# ci-dessus ne l'attrapait pas, et ses ~360 Mo d'intermédiaires ont fini
# versionnés : certains chemins dépassent 250 caractères, ce qui faisait échouer
# tout checkout Windows sur la limite MAX_PATH (260).
app/macos/build_xcode/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Client apps (APK/DMG/EXE) staged by publish-image.sh and copied into the
# Docker image. Never committed — they are hundreds of MB and rebuilt per
# release; the previously published image is what carries them between hosts.
server/downloads/*
!server/downloads/.gitkeep
