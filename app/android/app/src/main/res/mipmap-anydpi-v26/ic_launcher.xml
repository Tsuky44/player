<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative (Android 8+) : le lanceur découpe lui-même la forme —
     rond, goutte, squircle — dans un fond plein, au lieu de poser le PNG carré
     sur une pastille blanche. Les PNG de mipmap-*dpi restent pour Android 6-7. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
