<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Onyx</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>onyx</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(FLUTTER_BUILD_NAME)</string>
  <key>CFBundleVersion</key>
  <string>$(FLUTTER_BUILD_NUMBER)</string>
  <!--
    flutter-tvos copies `flutter_assets` to the app bundle root, but the
    prebuilt tvOS device engine's `+[FlutterDartProject lookupKeyForAsset:]`
    otherwise defaults to the iOS `Frameworks/App.framework/flutter_assets`
    path. Without this override every plugin that resolves a bundled asset
    via `lookupKeyForAsset:` (e.g. `VideoPlayerController.asset`) gets a
    path that does not exist on a physical device. `FLTAssetsPath` points
    the engine at the directory the build actually produces.
  -->
  <key>FLTAssetsPath</key>
  <string>flutter_assets</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!--
    Même décision que sur iOS (ADR-0011 §2) : le serveur est chez soi, en HTTP
    sur le réseau local, sans certificat.
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>NSBonjourServices</key>
  <array>
    <string>_http._tcp</string>
  </array>
  <!--
    Sans ce texte, tvOS refuse l'accès au réseau local sans rien demander : la
    découverte du serveur et l'appairage par le téléphone échoueraient en
    silence.
  -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Onyx cherche votre serveur média sur le réseau local, lit vos fichiers depuis celui-ci et reçoit la connexion envoyée par votre téléphone.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
  <key>UIMainStoryboardFile</key>
  <string>Main</string>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
</dict>
</plist>
